# ==================== 虚拟机基础设施配置 ====================
# 填你的 Linux 虚拟机 IP（例如 192.168.10.100）
VM_HOST=192.168.1.100

POSTGRES_DSN=postgresql://rag_user:rag_password_change_me@192.168.1.100:5432/ecom_rag
REDIS_URL=redis://192.168.1.100:6379/0

# ==================== 大模型 API 配置（OpenAI 兼容接口） ====================
# 示例（通义千问 DashScope / DeepSeek / OpenAI 均可）：
#   DeepSeek:   https://api.deepseek.com/v1
#   通义千问:    https://dashscope.aliyuncs.com/compatible-mode/v1
#   OpenAI:     https://api.openai.com/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-llm-api-key
LLM_MODEL=qwen-plus

# Embedding 模型（注意维度需与 docker/init.sql 中 vector(1024) 一致，如 text-embedding-v3 设 1024 维）
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ==================== Langfuse 可观测配置 ====================
# 若部署在虚拟机上，填 http://<VM_HOST>:3000；若用 Langfuse Cloud，填 https://cloud.langfuse.com
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://192.168.1.100:3000
LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxx

# ==================== 服务运行参数 ====================
APP_ENV=dev
RATE_LIMIT_PER_MIN=30
CACHE_TTL_SECONDS=600
